{
  "name": "arrow-vpn",
  "version": "3.1.4",
  "description": "Privacy-focused multi-provider VPN client for Windows powered by sing-box-lx",
  "main": "main.js",
  "type": "module",
  "author": "Arrow Systems",
  "license": "MIT",
  "homepage": "https://github.com/arrow-systems-org/arrow-vpn-windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/arrow-systems-org/arrow-vpn-windows.git"
  },
  "bugs": {
    "url": "https://github.com/arrow-systems-org/arrow-vpn-windows/issues"
  },
  "keywords": [
    "vpn",
    "privacy",
    "windows",
    "electron",
    "sing-box",
    "vless",
    "reality",
    "security",
    "censorship-evasion",
    "ipv6",
    "sing-box-lx",
    "xhttp",
    "hysteria2",
    "tuic",
    "multi-provider"
  ],
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check subscription.js && node --check protocols.js && node --check flags.js && node --check renderer.js && node --check preload.cjs",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.arrowx.vpn",
    "productName": "Arrow VPN",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.arrow-x.org/windows/stable"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "icon.png",
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Arrow VPN",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "allowElevation": true
    },
    "asarUnpack": [
      "bin/**/*"
    ],
    "asar": true,
    "files": [
      "main.js",
      "preload.cjs",
      "renderer.js",
      "subscription.js",
      "protocols.js",
      "flags.js",
      "index.html",
      "style.css",
      "icon.png",
      "icon1.png",
      "icon2.png",
      "bin/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
